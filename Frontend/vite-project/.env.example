# Copy to .env.local for local dev, or set as an Environment Variable in
# the Vercel project settings for production.
#
# Point this at your deployed Render backend, e.g.:
# VITE_API_BASE_URL=https://medico-backend.onrender.com
#
# Leave empty locally if you're using the Vite dev proxy in vite.config.ts.
VITE_API_BASE_URL=
